{
  "name": "CerdikGo Preview Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "CerdikGo local Worker preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install --ignore-scripts --no-audit --no-fund",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  }
}
